# Copy this file to .env and fill in your EmailJS values.
# Restart the dev server after changing .env (npm run dev)

VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Optional — Google Drive share links (Anyone with the link can view)
# Folder links show an embedded browser on /resources; file link for Computer 101 (large file)
VITE_GOOGLE_DRIVE_PRESENTATIONS_URL=
VITE_GOOGLE_DRIVE_HOW_TOS_URL=
VITE_GOOGLE_DRIVE_COMPUTER_101_URL=
